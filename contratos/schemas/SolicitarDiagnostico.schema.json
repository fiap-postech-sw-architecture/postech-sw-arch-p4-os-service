{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SolicitarDiagnostico (dados)",
  "description": "Campo dados da mensagem SolicitarDiagnostico (comando, os-service -> execution-service). Abre o passo T2 da saga: coloca o veículo na fila de diagnóstico da Execução.",
  "type": "object",
  "required": [
    "ordem_id",
    "veiculo_id",
    "veiculo",
    "descricao_problema"
  ],
  "properties": {
    "ordem_id": {
      "$ref": "#/$defs/uuid"
    },
    "veiculo_id": {
      "$ref": "#/$defs/uuid"
    },
    "veiculo": {
      "type": "object",
      "required": [
        "placa",
        "marca",
        "modelo",
        "ano"
      ],
      "properties": {
        "placa": {
          "type": "string",
          "pattern": "^[A-Z]{3}[0-9][A-Z0-9][0-9]{2}$",
          "description": "Placa normalizada, sem hífen: padrão antigo (ABC1234) ou Mercosul (ABC1D23)."
        },
        "marca": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "modelo": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "ano": {
          "type": "integer",
          "minimum": 1887
        }
      }
    },
    "descricao_problema": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid"
    }
  }
}
