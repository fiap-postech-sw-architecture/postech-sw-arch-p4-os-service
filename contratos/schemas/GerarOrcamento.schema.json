{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GerarOrcamento (dados)",
  "description": "Campo dados da mensagem GerarOrcamento (comando, os-service -> billing-service). Passo T3: o Billing precifica os itens do diagnóstico e gera o orçamento.",
  "type": "object",
  "required": [
    "ordem_id",
    "itens"
  ],
  "properties": {
    "ordem_id": {
      "$ref": "#/$defs/uuid"
    },
    "itens": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/item"
      },
      "maxItems": 50
    }
  },
  "$defs": {
    "codigo": {
      "type": "string",
      "maxLength": 50,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "description": "Código do serviço ou SKU da peça na tabela de preços do Billing (até 50 caracteres)."
    },
    "item": {
      "type": "object",
      "required": [
        "tipo",
        "codigo",
        "quantidade"
      ],
      "properties": {
        "tipo": {
          "$ref": "#/$defs/tipo_item"
        },
        "codigo": {
          "$ref": "#/$defs/codigo"
        },
        "quantidade": {
          "$ref": "#/$defs/quantidade"
        }
      }
    },
    "quantidade": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "tipo_item": {
      "enum": [
        "servico",
        "peca"
      ]
    },
    "uuid": {
      "type": "string",
      "format": "uuid"
    }
  }
}
