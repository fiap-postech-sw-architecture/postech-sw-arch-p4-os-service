{
  "permissions": [
    {
      "user": "os",
      "vhost": "/",
      "configure": "^$",
      "write": "^(pytstop\\.comandos|pytstop\\.retry)$",
      "read": "^os\\.eventos$"
    },
    {
      "user": "billing",
      "vhost": "/",
      "configure": "^$",
      "write": "^(pytstop\\.eventos|pytstop\\.retry)$",
      "read": "^billing\\.comandos$"
    },
    {
      "user": "execucao",
      "vhost": "/",
      "configure": "^$",
      "write": "^(pytstop\\.eventos|pytstop\\.retry)$",
      "read": "^execucao\\.comandos$"
    }
  ],
  "topic_permissions": [
    {
      "user": "os",
      "vhost": "/",
      "exchange": "pytstop.comandos",
      "write": "^comando\\.(billing|execucao)\\.",
      "read": "^$"
    },
    {
      "user": "os",
      "vhost": "/",
      "exchange": "pytstop.retry",
      "write": "^os\\.eventos\\.retry\\.(1|5|15|60|300)s$",
      "read": "^$"
    },
    {
      "user": "billing",
      "vhost": "/",
      "exchange": "pytstop.eventos",
      "write": "^evento\\.billing\\.",
      "read": "^$"
    },
    {
      "user": "billing",
      "vhost": "/",
      "exchange": "pytstop.retry",
      "write": "^billing\\.comandos\\.retry\\.(1|5|15|60|300)s$",
      "read": "^$"
    },
    {
      "user": "execucao",
      "vhost": "/",
      "exchange": "pytstop.eventos",
      "write": "^evento\\.execucao\\.",
      "read": "^$"
    },
    {
      "user": "execucao",
      "vhost": "/",
      "exchange": "pytstop.retry",
      "write": "^execucao\\.comandos\\.retry\\.(1|5|15|60|300)s$",
      "read": "^$"
    }
  ]
}
