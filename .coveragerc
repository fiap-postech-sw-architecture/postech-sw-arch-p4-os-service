# Gate de cobertura do OS Service (ADR-041 e RFC-004, secao 10.2: fail_under =
# 95; o enunciado pede 80). `uv run pytest` ja liga --cov=src (addopts no
# pyproject) e falha abaixo de fail_under. branch=True mede ramos, nao so linhas.
# O diff-cover (make diff-cover) exige 90% no codigo novo.

[run]
relative_files = True
branch = True
source = src
omit =
    tests/*
    */__init__.py
    # Modulos so com Protocols (ports, sem logica): a linha so "cobre" via
    # import; excluir torna o gate honesto em vez de premiar import morto.
    src/*/dominio/repository.py
    src/*/aplicacao/ports.py
    src/compartilhado/aplicacao/unit_of_work.py

[report]
fail_under = 95
show_missing = True
skip_covered = True
