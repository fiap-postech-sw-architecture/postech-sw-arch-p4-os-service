# Variaveis do OS Service com os valores de DEMONSTRACAO do docker-compose.yml.
# Fora do compose: `cp .env.example .env`, ajuste e exporte antes de rodar
# (`set -a; . ./.env; set +a`). Em ambiente exposto tudo entra por Secret: com
# ENVIRONMENT=production o boot recusa os literais de demonstracao abaixo.

# development e test pulam a guarda de segredos; qualquer outro valor a liga
# (a imagem Docker sobe com production).
ENVIRONMENT=development

# Banco. DATABASE_URL tem precedencia; em development/test a URL pode ser
# montada das POSTGRES_*. Fora deles DATABASE_URL e obrigatoria.
# DATABASE_URL=postgresql://usuario:senha@host:5432/os
POSTGRES_DB=os
POSTGRES_USER=pytstop
POSTGRES_PASSWORD=pytstop  # gitleaks:allow (senha do banco de demo)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Pool por replica e tempos (segundos).
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800
DB_CONNECT_TIMEOUT=5

# JWT RS256: chave privada RSA de 2048 bits ou mais em PEM (openssl genpkey
# -algorithm RSA -pkeyopt rsa_keygen_bits:2048, fora do repositorio). A publica
# sai no JWKS (/.well-known/jwks.json). Na rotacao, JWT_PREVIOUS_PUBLIC_KEY
# recebe a publica da chave que entra (etapa 1) e depois a da que sai (etapa 2)
# (openssl pkey -in chave.pem -pubout): so publicada e aceita na validacao,
# nunca assina. As etapas estao no README. Validade em minutos: access de 15
# (ate 60) e refresh de 7 dias (ate 30 dias).
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
MIIEvQIBADANBgkqhkiG9w0BAQEFAASCBKcwggSjAgEAAoIBAQCrnHu8kBQQGe7e
aDIDjS058VmeT2PJs2e3nXC+YCS0FQJ6xoYwOlJhWu/6xiK/ETR/hkf/wWDMlSqY
