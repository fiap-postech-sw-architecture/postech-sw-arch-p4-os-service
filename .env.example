JWT_PREVIOUS_PUBLIC_KEY=
JWT_EXPIRATION_MINUTES=15
JWT_REFRESH_EXPIRATION_MINUTES=10080

# Chave Fernet dos dados pessoais (Fernet.generate_key()). Sem ela, fora de
# producao, o app gera uma efemera e os dados cifrados nao sobrevivem ao restart.
ENCRYPTION_KEY=Chqh4o4QURACWBUSdtXjAxhOQt6HhxAfEg9rtvsABKU=  # gitleaks:allow (chave Fernet de demo)

# Admin semeado por scripts/seed_admin.py (senha de 12 caracteres ou mais).
ADMIN_EMAIL=admin@pytstop.dev
ADMIN_PASSWORD=admin-demo-os-2026  # gitleaks:allow (senha de demo)
# entrypoint.sh da imagem: migracao e seed no boot (o compose liga os dois).
RUN_MIGRATIONS_ON_STARTUP=false
RUN_SEED_ON_STARTUP=false

# Borda e protecao. Origens CORS separadas por virgula (vazio = nenhuma; `*` e
# recusado). TRUSTED_PROXIES: IPs ou CIDRs cujo X-Forwarded-For e aceito
# (vazio = nenhum). RATE_LIMIT, na notacao do pacote limits, e o limite padrao
# por IP e so vale para as rotas registradas direto no app (Swagger e OpenAPI):
# as rotas sem token e as de credencial levam limite proprio no codigo, e o
# limite agregado de toda a API e do Kong.
CORS_ORIGINS=
TRUSTED_PROXIES=
RATE_LIMIT=60/minute

# Mensageria: relay da outbox e consumidor de os.eventos (`uv run python -m
# src.relay` e `uv run python -m src.consumidor`); a API so grava a outbox.
# Usuario `os` do RabbitMQ do compose (127.0.0.1:5674); no Kubernetes,
# amqp://os:<senha>@rabbitmq.pytstop-plataforma.svc.cluster.local:5672/%2F.
# Com ENVIRONMENT=production o boot recusa esta senha de demonstracao.
RABBITMQ_URL=amqp://os:pytstop-os-demo-2026@127.0.0.1:5674/%2F  # gitleaks:allow (senha de demo)
# /metrics do relay e do consumidor (a API serve /metrics na porta HTTP).
METRICS_PORT=9100
# Relay: poll de seguranca em segundos (alem do NOTIFY, de 0,1 a 15), linhas por
# lote e lease em segundos de cada linha reivindicada (45 ou mais; renovado antes
# de cada publicacao, cobre o publish bloqueado por alarme do broker, de ate 30 s).
OUTBOX_POLL_SEGUNDOS=5
OUTBOX_LOTE=10
OUTBOX_LEASE_SEGUNDOS=60

# Observabilidade. As metricas da API e a instrumentacao do FastAPI exigem o
# extra otel (`uv sync --extra otel`, a imagem o instala). No relay e no
# consumidor o span de cada mensagem existe sempre (o traceparent segue pela
# outbox e pelo AMQP e os logs levam trace_id); OTEL_ENABLED liga a exportacao
# OTLP (gRPC) para o Jaeger.
API_METRICS_ENABLED=false
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
# service.name dos spans (o platform injeta os-service no cluster).
OTEL_SERVICE_NAME=pytstop-os-service

# Servidor de desenvolvimento (`uv run python -m src.main`).
UVICORN_HOST=127.0.0.1
UVICORN_PORT=8000

# So do compose: portas no host (127.0.0.1) e nome da imagem.
APP_PORT=8000
RABBITMQ_PORT=5674
RABBITMQ_UI_PORT=15674
APP_IMAGE=pytstop-os-service:dev
