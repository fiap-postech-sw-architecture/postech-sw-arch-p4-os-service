# Variaveis do OS Service com os valores de DEMONSTRACAO do docker-compose.yml.
# Fora do compose: `cp .env.example .env`, ajuste e exporte antes de rodar
# (`set -a; . ./.env; set +a`). Em ambiente exposto tudo entra por Secret: com
# ENVIRONMENT=production o boot recusa os literais de demonstracao abaixo.

# development e test pulam a guarda de segredos; qualquer outro valor a liga
# (a imagem Docker sobe com production).
ENVIRONMENT=development

# Banco. DATABASE_URL tem precedencia; em development/test a URL pode ser
# montada das POSTGRES_*. Fora deles DATABASE_URL e obrigatoria.
# DATABASE_URL=postgresql://usuario:senha@host:5432/os
POSTGRES_DB=os
POSTGRES_USER=pytstop
POSTGRES_PASSWORD=pytstop  # gitleaks:allow (senha do banco de demo)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Pool por replica e tempos (segundos).
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800
DB_CONNECT_TIMEOUT=5

# JWT HS256: segredo de 32 bytes ou mais (openssl rand -hex 32). Validade em
# minutos: access de 15 e refresh de 7 dias.
JWT_SECRET=demo-jwt-secret-os-service-fase4-nao-usar-em-producao  # gitleaks:allow (segredo de demo)
JWT_EXPIRATION_MINUTES=15
JWT_REFRESH_EXPIRATION_MINUTES=10080

# Chave Fernet dos dados pessoais (Fernet.generate_key()). Sem ela, fora de
# producao, o app gera uma efemera e os dados cifrados nao sobrevivem ao restart.
ENCRYPTION_KEY=Chqh4o4QURACWBUSdtXjAxhOQt6HhxAfEg9rtvsABKU=  # gitleaks:allow (chave Fernet de demo)

# Admin semeado por scripts/seed_admin.py (senha de 12 caracteres ou mais).
ADMIN_EMAIL=admin@pytstop.dev
ADMIN_PASSWORD=admin-demo-os-2026  # gitleaks:allow (senha de demo)
# entrypoint.sh da imagem: migracao e seed no boot (o compose liga os dois).
RUN_MIGRATIONS_ON_STARTUP=false
RUN_SEED_ON_STARTUP=false

# Borda e protecao. Origens CORS separadas por virgula (vazio = nenhuma; `*` e
# recusado). TRUSTED_PROXIES: IPs ou CIDRs cujo X-Forwarded-For e aceito
# (vazio = nenhum). RATE_LIMIT na notacao do pacote limits.
CORS_ORIGINS=
TRUSTED_PROXIES=
RATE_LIMIT=60/minute

# Observabilidade (exigem o extra otel: `uv sync --extra otel`).
API_METRICS_ENABLED=false
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317

# Servidor de desenvolvimento (`uv run python -m src.main`).
UVICORN_HOST=127.0.0.1
UVICORN_PORT=8000

# So do compose: porta da API no host (127.0.0.1) e nome da imagem.
APP_PORT=8000
APP_IMAGE=pytstop-os-service:dev
