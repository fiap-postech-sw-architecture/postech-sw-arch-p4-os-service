# O COPY . . do Dockerfile embute tudo que nao estiver listado aqui.

# Git e ferramentas de agente
.git
.gitignore
.gitattributes
.gitleaks.toml
.github/
.claude/
.cursor/

# Documentacao
docs/
*.md

# Testes e qualidade (so o CI usa)
tests/
.coverage
.coverage.*
.coveragerc
coverage.xml
htmlcov/
reports/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.import_linter_cache/
.scannerwork/
.sonar/
sonar-project.properties
# Dos scripts, so os do CI saem. Ficam os que o container roda: o seed_admin.py
# (entrypoint) e o validar_token.py, que o `make smoke` roda dentro da imagem so
# com o PyJWT que ela ja tem.
scripts/sonar/
scripts/cobertura_resumo.py

# Python
**/__pycache__
**/*.pyc
*.egg-info/
.venv
build/
dist/

# Chaves privadas (a JWT_PRIVATE_KEY entra por Secret): nunca na imagem. No
# .dockerignore `*.pem` so alcanca a raiz; o `**/` alcanca todas as pastas.
**/*.pem
**/*.key

# Ambiente local e orquestracao
.env
.env.*
docker-compose.yml
Makefile
k8s/
**/*.log
.DS_Store
